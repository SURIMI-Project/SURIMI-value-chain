<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SURIMI_value_chain</RootNamespace>
    <UserSecretsId>6bda8557-afad-46b7-b328-2c728b3788b1</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Models\**" />
    <Compile Remove="Properties\PublishProfiles\**" />
    <Content Remove="Models\**" />
    <Content Remove="Properties\PublishProfiles\**" />
    <EmbeddedResource Remove="Models\**" />
    <EmbeddedResource Remove="Properties\PublishProfiles\**" />
    <None Remove="Models\**" />
    <None Remove="Properties\PublishProfiles\**" />
    <_WebToolingArtifacts Remove="Properties\PublishProfiles\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BSR.Surimi.Surimi-Protocol.Grpc.Csharp" Version="1.84.10001.99+61957519940d" />
    <PackageReference Include="Eii.BlobStore.S3" Version="1.0.6" />
    <PackageReference Include="Eii.ValueChain" Version="1.0.*" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.84.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Google.Api.CommonProtos" Version="2.17.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <PackageReference Include="Grpc.StatusProto" Version="2.71.0" />
    <PackageReference Include="SURIMI.Common" Version="1.0.*" />
    <PackageReference Include="SURIMI.Datamodel" Version="3.0.*" />
    <PackageReference Include="SURIMI.SemanticRegistry" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Includes\anchovy_bay\" />
    <Folder Include="Includes\northwestern_med\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Includes\anchovy_bay\anchovy_bay.vc.sqlite">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Includes\northwestern_med\northwestern_med.vc.sqlite">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
